<template>
  <div class="page" onswipe="swipe">
    <image if="{{mode === 'title' || mode === 'end'}}" class="screen-art" src="/common/ui/title.jpg"></image>
    <image if="{{mode !== 'title' && mode !== 'play' && mode !== 'choice' && mode !== 'cg' && mode !== 'end'}}" class="screen-art" src="/common/ui/panel.jpg"></image>
    <div if="{{mode === 'play' || mode === 'choice'}}" class="art">
      <image for="{{actors}}" tid="key" class="body" style="left: {{$item.x}}px; top: {{$item.y}}px; width: {{$item.w}}px; height: {{$item.h}}px;" src="{{$item.src}}" onerror="sceneLayerFailed($item.key)"></image>
      <div class="art-touch" onclick="dialogueTap" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" ontouchcancel="dialogueTouchEnd"></div>
    </div>
    <div if="{{mode === 'title'}}" class="title-panel">
      <text class="title-action" onclick="startNew">开始阅读</text>
      <text class="title-action" onclick="continueGame">读取存档</text>
      <text class="title-action" onclick="openGallery">CG 鉴赏</text>
      <text class="title-action" onclick="openConfig">阅读设置</text>
    </div>
    <image if="{{mode === 'title' || mode === 'end'}}" class="title-logo" src="/common/ui/title-logo.png"></image>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <image class="dialogue-skin" src="/common/ui/dialogue.png"></image>
      <div class="speaker-row"><div if="{{speaker !== ''}}" class="nameplate"><image class="name-skin" src="/common/ui/window_name.png"></image><text class="speaker">{{speaker}}</text></div></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" onclick="dialogueTap" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" ontouchcancel="dialogueTouchEnd" onscroll="dialogueScrolled"><div class="dialogue-content"><text for="{{dialogueRows}}" tid="id" class="dialogue-line" style="font-size: {{fontSize}}px;">{{$item.text}}</text></div></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">‹ 上一句</text><text class="tool menu-tool" onclick="showMenu">菜单</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <image class="dialogue-skin" src="/common/ui/dialogue.png"></image><text class="choice-title">请选择</text>
      <text for="{{options}}" tid="text" class="choice" onclick="pick($idx)">{{$item.text}}</text>
      <text class="small-action" onclick="showMenu">阅读菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay menu-panel">
      <text class="menu-title">阅读菜单</text>
      <text class="menu-action" onclick="saveGame">保存进度</text>
      <text class="menu-action" onclick="loadGame">读取进度</text>
      <text class="menu-action" style="color: {{hasNextChapter ? '#f5f7ff' : '#abb9ca'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action" onclick="toggleAuto">{{autoLabel}}</text>
      <text class="menu-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="menu-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action" onclick="resume">返回游戏</text>
      <text class="menu-action" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'config'}}" class="overlay config-panel">
      <text class="panel-title">阅读设置</text><text class="panel-subtitle">SETTINGS</text>
      <text class="config-action" onclick="toggleMusic">{{musicLabel}}</text>
      <text class="config-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="config-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="config-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="config-note">自动播放可在阅读菜单开启。逐字显示完成后稍等，继续下一句。遇到选项暂停，选择后自动继续。</text>
      <text class="config-action config-back" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text><text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list"><div for="{{slotRows}}" tid="number" class="slot-card" onclick="selectSlot($item.index)"><image class="slot-skin" src="/common/ui/slot.png"></image><text class="slot-title">{{$item.title}}</text><text class="slot-meta">{{$item.meta}}</text><text class="slot-preview">{{$item.preview}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay confirm-panel">
      <text class="menu-title">{{overwriteTitle}}</text><text class="confirm-text">{{overwriteDetail}}</text>
      <text class="config-action" onclick="confirmOverwrite">确认覆盖</text><text class="config-action" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-caption">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action cg-link" onclick="previousCg">‹ 上一组</text><text class="pager-action cg-link" onclick="backToGallery">返回列表</text><text class="pager-action cg-link" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">二六线 · 完</text><text class="subtitle">感谢阅读</text><text class="config-action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay confirm-panel"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="config-action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading && (mode !== 'play' || storyLoadingNotice)}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import audio from '@system.audio';
import {makeTitleMusic} from '../../common/title-music.js';
import {CHAPTERS,COUNTS,CHUNK_SIZE} from '../../common/catalog.js';
import storage from '@system.storage';
import prompt from '@system.prompt';
import {newState,restore,readFrame,readChapterSkip,next,nextChapter,choose,previous} from '../../common/engine.js';
import {SLOT_COUNT,LEGACY_KEY,slotKey,decodeSave,createSave,slotRow} from '../../common/saves.js';
import {imagePath} from '../../common/assets.js';

import {groupGallery,stepVariant} from '../../common/gallery.js';
import {autoSpeeds,autoWait} from '../../common/auto-reader.js';
import {normalizeText} from '../../common/text-format.js';
import {wrapText,planTextRows,revealTextRows,nextGlyphEnd} from '../../common/text-reveal.js';
export default {
  private:{mode:'title',dialogueRows:[],actors:[],musicEnabled:true,musicLabel:'标题音乐：开启',backgroundSrc:'/common/images/black.jpg',bodySrc:'',bodyLeft:0,bodyTop:0,bodyWidth:432,bodyHeight:286,speaker:'',displayText:'',chapterLabel:'',
    options:[],loading:false,storyLoadingNotice:false,errorText:'',hasNextChapter:true,autoEnabled:false,autoSpeed:1,autoLabel:'自动播放：关闭',autoSpeedLabel:'自动速度：标准',fontSize:24,textSpeed:30,speedLabel:'显示速度：逐字',fontLabel:'字号：标准',
    slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',
    galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:''},
  onInit(){
    this.session=newState();this.cachedChapter=0;this.ops=[];this.loadSequence=0;this.timer=null;this.fullText='';this.resumeMode='play';this.autoEnabled=false;this._alive=true;this._hidden=false;this._pendingFrame=false;this._autoTimer=null;this._autoGeneration=0;this._typingGeneration=0;this._touchReading=false;
    this._music=makeTitleMusic(audio,value=>{if(!value){this.musicEnabled=false;this.refreshSettings();}});try{this.$app.$def.titleMusicController=this._music;}catch(e){}this.syncMusic();
    this._sceneSignature='';this._storyAhead=null;this._storyNoticeTimer=null;this._textGeneration=0;this._textRanges=[];this._slotLoaded=Array(SLOT_COUNT).fill(false);this._legacyChecked=false;
    this._slotsSequence=0;this._gallerySequence=0;this._slotData=Array(SLOT_COUNT).fill(null);this._galleryCatalog=[];this._galleryTotal=0;this._slotsReturnMode='title';this._slotRole='load';
    storage.get({complete:()=>{},key:'maitetsu_rw5_settings_v1',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===28?28:24;this.textSpeed=s.textSpeed===0?0:30;this.autoSpeed=s.autoSpeed===0||s.autoSpeed===2?s.autoSpeed:1;this.musicEnabled=s.musicEnabled!==false;this.refreshSettings();this.syncMusic();}catch(e){}},fail:()=>{}});
    console.log('MAITETSU_RW5 title ready');
  },
  updateScene(){
    if(this._sceneSignature===this.session.sceneId)return;
    this._sceneSignature=this.session.sceneId;
    this.actors=this.session.layers.map(layer=>Object.assign({},layer,{src:imagePath(layer.image),key:layer.image}));
  },
  sceneLayerFailed(key){if((this.mode==='play'||this.mode==='choice')&&this.actors.some(a=>a.key===key))this.fail('场景图片读取失败，请返回标题后读取存档');},
  clearStoryNotice(){
    if(this._storyNoticeTimer!==null)clearTimeout(this._storyNoticeTimer);
    this._storyNoticeTimer=null;this.storyLoadingNotice=false;
  },
  cancelStoryRead(){this.clearStoryNotice();this._storyAhead=null;this.loadSequence++;},
  paintText(length){revealTextRows(this.dialogueRows,this._textRanges,length);this.displayText=this.fullText.slice(0,length);},
  beginText(f){
    this._pendingFrame=false;this.loading=false;this.speaker=normalizeText(f.speaker);this.fullText=wrapText(normalizeText(f.text),396,this.fontSize);this.displayText='';
    const plan=planTextRows(this.fullText,++this._textGeneration);this._textRanges=plan.ranges;this.dialogueRows=plan.rows;
    this._dialogueDragged=false;this._dialogueIgnoreUntil=0;try{this.$element('dialogue-scroll').scrollTo({top:0});}catch(e){}
    console.log('MAITETSU_RW5 frame',this.session.chapter,this.session.cursor);
    this.prefetchStory();
    const speed=this.autoEnabled?30:this.textSpeed,generation=this._typingGeneration;
    if(speed===0){this.paintText(this.fullText.length);this.armAuto();return;}
    const tick=()=>{if(!this._alive||this._hidden||this.mode!=='play'||generation!==this._typingGeneration)return;this.timer=null;this.paintText(nextGlyphEnd(this.fullText,this.displayText.length));if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,speed);else this.armAuto();};tick();
  },
  clearTyping(){this.clearAuto();this._typingGeneration++;if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  clearAuto(){if(this._autoTimer!=null)clearTimeout(this._autoTimer);this._autoTimer=null;this._autoGeneration=(this._autoGeneration||0)+1;},
  canAuto(){return this.autoEnabled&&this._alive&&!this._hidden&&!this._touchReading&&!this.loading&&!this.storageBusy&&this.mode==='play'&&this.timer===null&&this.displayText===this.fullText;},
  armAuto(){
    this.clearAuto();if(!this.canAuto())return;
    const generation=this._autoGeneration,chapter=this.session.chapter,cursor=this.session.cursor;
    this._autoTimer=setTimeout(()=>{if(generation!==this._autoGeneration)return;this._autoTimer=null;if(!this.canAuto()||this.session.chapter!==chapter||this.session.cursor!==cursor)return;console.log('MAITETSU_RW5 auto advance',chapter,cursor);this.advance();},autoWait(this.autoSpeed,this.fullText.length));
  },
  stopAuto(){this.autoEnabled=false;this.clearAuto();this.refreshSettings();},
  toggleAuto(){if(this.mode!=='menu')return;this.autoEnabled=!this.autoEnabled;this.clearAuto();this.refreshSettings();console.log('MAITETSU_RW5 auto enabled',this.autoEnabled);},
  cycleAutoSpeed(){if(this.mode!=='menu'&&this.mode!=='config')return;this.autoSpeed=(this.autoSpeed+1)%3;this.refreshSettings();this.persistSettings();console.log('MAITETSU_RW5 auto speed',this.autoSpeed);},

  onShow(){this._hidden=false;this.syncMusic();if(this._pendingFrame||(this._chapterSkip&&this.timer===null))this.renderFrame();else this.armAuto();},
  onHide(){this.cancelStoryRead();this._hidden=true;if(this._music)this._music.update(false);this._touchReading=false;this.clearTyping();if(!this._chapterSkip&&this.mode==='play'&&!this._pendingFrame)this.paintText(this.fullText.length);},
  onDestroy(){this.cancelStoryRead();this._alive=false;if(this._music)this._music.destroy();try{this.$app.$def.titleMusicController=null;}catch(e){}this.stopAuto();this.clearTyping();this._slotsSequence++;this._gallerySequence++;},
  startNew(){if(this.loading||this.mode!=='title')return;this.stopAuto();this.clearTyping();this._chapterSkip=null;this.session=newState();this.cachedChapter=0;this.renderFrame();},
  continueGame(){if(this.mode==='title')this.openSlots('load');},
  openConfig(){if(this.loading||this.mode!=='title')return;this.clearTyping();this.mode='config';this.syncMusic();console.log('MAITETSU_RW5 config');},
  readStoryFile(key,done){
    file.readText({complete:()=>{},uri:'/common/story/'+key+'.txt',success:data=>{
      let ops;
      try{ops=JSON.parse(data.text);if(!ops||ops.v!==2||!Array.isArray(ops.lines)||!Array.isArray(ops.scenes))throw Error('章节格式无效');}
      catch(error){done(error.message);return;}
      done('',ops);
    },fail:(data,code)=>done('剧情读取失败：'+code)});
  },
  prefetchStory(){
    const {chapter,cursor}=this.session;
    const nextBlock=Math.floor(cursor/CHUNK_SIZE)+1,boundary=Math.min(nextBlock*CHUNK_SIZE,COUNTS[chapter-1]);
    if(boundary-cursor>6||this._storyAhead)return;
    const endOfChapter=boundary===COUNTS[chapter-1];
    if(endOfChapter&&chapter===COUNTS.length)return;
    const entry={key:endOfChapter?(chapter+1)+'-0':chapter+'-'+nextBlock,ops:null,failed:false,waiter:null};
    this._storyAhead=entry;
    this.readStoryFile(entry.key,(error,ops)=>{
      if(this._storyAhead!==entry)return;
      entry.ops=ops;
      if(entry.waiter){this._storyAhead=null;entry.waiter(error,ops);}
      else entry.failed=!!error;
    });
  },
  readChapter(chapter,done){
    const cursor=this.session.cursor,key=chapter+'-'+Math.floor(cursor/CHUNK_SIZE);
    if(cursor>=COUNTS[chapter-1]||this.cachedChapter===key){done();return;}
    const seq=++this.loadSequence;
    const accept=(error,ops)=>{
      if(seq!==this.loadSequence)return;
      this.clearStoryNotice();
      if(error){this.fail('第 '+chapter+' 章'+error);return;}
      this.ops=ops;this.cachedChapter=key;
      done();
    };
    const ahead=this._storyAhead;
    if(ahead&&ahead.key===key&&ahead.ops){this._storyAhead=null;accept('',ahead.ops);return;}
    this.loading=true;this.clearStoryNotice();
    this._storyNoticeTimer=setTimeout(()=>{this._storyNoticeTimer=null;if(seq===this.loadSequence)this.storyLoadingNotice=true;},350);
    if(ahead&&ahead.key===key&&!ahead.failed){
      ahead.waiter=(error,ops)=>{if(seq!==this.loadSequence)return;if(error)this.readStoryFile(key,accept);else accept('',ops);};
      return;
    }
    this._storyAhead=null;
    this.readStoryFile(key,accept);
  },
  renderFrame(){
    this._pendingFrame=true;this.clearTyping();this.readChapter(this.session.chapter,()=>{
      if(this._hidden)return;
      try{
        const f=this._chapterSkip?readChapterSkip(this.ops,this.session,this._chapterSkip):readFrame(this.ops,this.session);
        if(f.type==='jump'){this.session.chapter=f.to[0];this.session.cursor=f.to[1];this.renderFrame();return;}if(f.type==='yield'){this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;}this._chapterSkip=null;this._pendingFrame=false;this.loading=false;
        this.hasNextChapter=this.session.chapter<4;
        if(f.type==='choice'){this.options=f.items.map(item=>Object.assign({},item,{text:normalizeText(item.text)}));this.mode='choice';this.syncMusic();console.log('MAITETSU_RW5 choice',this.session.chapter,this.session.cursor);return;}
        if(f.type==='end'){this.stopAuto();this.actors=[];this.ops=[];this._storyAhead=null;this.mode='end';this.syncMusic();console.log('MAITETSU_RW5 ending');return;}
        this.mode='play';this.syncMusic();this.updateScene();this.beginText(f);
      }catch(e){this.fail(e.message);}
    });
  },
  advance(){if(this.loading||this.mode!=='play')return;this.clearAuto();if(this.timer!==null){this.clearTyping();this.paintText(this.fullText.length);this.armAuto();return;}next(this.session);this.renderFrame();},
  dialoguePoint(event){const t=event&&((event.touches&&event.touches[0])||(event.changedTouches&&event.changedTouches[0]));return t?{x:Number(t.clientX===undefined?t.pageX:t.clientX),y:Number(t.clientY===undefined?t.pageY:t.clientY)}:null;},
  dialogueTouchStart(event){this._touchReading=true;this.clearAuto();this._dialogueTouch=this.dialoguePoint(event);this._dialogueDragged=false;},
  dialogueTouchMove(event){const p=this.dialoguePoint(event),start=this._dialogueTouch;if(p&&start&&(Math.abs(p.x-start.x)>8||Math.abs(p.y-start.y)>8))this._dialogueDragged=true;},
  dialogueTouchEnd(){if(this._dialogueDragged)this._dialogueIgnoreUntil=Date.now()+450;this._dialogueTouch=null;this._touchReading=false;this.armAuto();},
  dialogueScrolled(){if(this._dialogueTouch){this._dialogueDragged=true;this._dialogueIgnoreUntil=Date.now()+450;}if(this.mode==='play')this.armAuto();},
  dialogueTap(){if(this._dialogueDragged||Date.now()<(this._dialogueIgnoreUntil||0)){this._dialogueDragged=false;return;}this.advance();},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;if(this.resumeMode==='choice'){this.mode='choice';this.syncMusic();this.toast('请先作出当前选择');return;}this.clearTyping();this._chapterSkip=nextChapter(this.session);if(!this._chapterSkip){this.toast('本篇已结束');return;}this._autoHops=0;this.loading=true;this.renderFrame();console.log('MAITETSU_RW5 safe chapter skip',this.session.chapter,this.session.cursor);},
  pick(index){if(this.mode!=='choice'||this.loading)return;choose(this.session,this.options[index],index);this.renderFrame();},
  goBack(){if(this.loading||this.mode!=='play')return;this.stopAuto();this.clearTyping();if(previous(this.session))this.renderFrame();else this.toast('已经是第一句');},
  showMenu(){if(this.loading||(this.mode!=='play'&&this.mode!=='choice'))return;this.clearTyping();this.paintText(this.fullText.length);this.resumeMode=this.mode;this.mode='menu';this.syncMusic();console.log('MAITETSU_RW5 menu',this.session.chapter);},
  resume(){if(this.mode!=='menu')return;this.mode=this.resumeMode;this.syncMusic();this.armAuto();},
  swipe(event){
    if(event.direction==='right'&&this.mode==='config'){this.toTitle();return;}
    if(this.mode==='gallery'){if(event.direction==='left')this.nextGalleryPage();if(event.direction==='right')this.previousGalleryPage();return;}
    if(event.direction==='right'&&(this.mode==='play'||this.mode==='choice'))this.showMenu();
  },
  saveGame(){this.openSlots('save');},
  loadGame(){this.openSlots('load');},
  openSlots(role){
    if(this.loading||this.storageBusy)return;this.clearTyping();this._slotsReturnMode=this.mode;this._slotRole=role;
    this._pendingSave=role==='save'?createSave(this.session,this.resumeMode,Date.now()):null;
    this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this.slotPage=0;this.slotRows=[];this.mode='slots';this.syncMusic();this.loading=true;
    ++this._slotsSequence;this.loadSlotPage();
  },
  loadSlotPage(){
    const seq=++this._slotsSequence,start=this.slotPage*4,end=Math.min(start+4,SLOT_COUNT);this.loading=true;
    const ready=()=>{if(seq!==this._slotsSequence)return;this.loading=false;this.refreshSlotRows();console.log('MAITETSU_RW5 slots ready',this._slotRole,this.slotPage);};
    const next=i=>{if(seq!==this._slotsSequence)return;if(i===end){if(start===0&&!this._legacyChecked&&!this._slotData[0]){this._legacyChecked=true;storage.get({complete:()=>{},key:LEGACY_KEY,default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const old=decodeSave(data);if(old){old.legacy=true;this._slotData[0]=old;}}catch(e){}ready();},fail:ready});}else ready();return;}
      if(this._slotLoaded[i]){next(i+1);return;}const more=()=>{this._slotLoaded[i]=true;setTimeout(()=>next(i+1),0);};
      storage.get({complete:()=>{},key:slotKey(i),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{this._slotData[i]=decodeSave(data);}catch(e){this._slotData[i]={invalid:true};}more();},fail:()=>{if(seq!==this._slotsSequence)return;this._slotData[i]={invalid:true};more();}});
    };next(start);
  },
  refreshSlotRows(){const start=this.slotPage*4;const rows=[];for(let i=start;i<Math.min(start+4,SLOT_COUNT);i++)rows.push(slotRow(i,this._slotData[i]));this.slotRows=rows.map(row=>Object.assign({},row,{title:normalizeText(row.title),meta:normalizeText(row.meta),preview:normalizeText(row.preview)}));this.slotPageLabel=SLOT_COUNT+' 个栏位 · 第 '+(this.slotPage+1)+' / '+Math.ceil(SLOT_COUNT/4)+' 页';},
  previousSlotPage(){if(this.loading||this.slotPage===0)return;this.slotPage--;this.loadSlotPage();},
  nextSlotPage(){if(this.loading||this.slotPage>=Math.ceil(SLOT_COUNT/4)-1)return;this.slotPage++;this.loadSlotPage();},
  closeSlots(){if(this.storageBusy)return;this._slotsSequence++;this.loading=false;this.mode=this._slotsReturnMode;this.syncMusic();this.armAuto();},
  selectSlot(index){
    if(this.loading||this.storageBusy||this.mode!=='slots'||index<0||index>=SLOT_COUNT||!this._slotLoaded[index])return;
    const saved=this._slotData[index];
    if(this._slotRole==='load'){
      if(!saved){this.toast('这个栏位还没有存档');return;}if(saved.invalid){this.toast('这个存档无法读取');return;}
      try{this.session=restore(saved.state);this.cachedChapter=0;this._slotsSequence++;this.renderFrame();console.log('MAITETSU_RW5 slot loaded',index+1,this.session.chapter,this.session.cursor);}catch(e){this.toast(e.message);}return;
    }
    this._pendingSlotIndex=index;
    if(saved){const row=slotRow(index,saved);this.overwriteTitle='覆盖'+row.title+'？';this.overwriteDetail=row.meta+'\n覆盖后将保存当前进度。';this.mode='overwrite';this.syncMusic();console.log('MAITETSU_RW5 overwrite',index+1);return;}
    this.commitSlot();
  },
  confirmOverwrite(){if(this.mode==='overwrite')this.commitSlot();},
  cancelOverwrite(){if(!this.storageBusy)this.mode='slots';this.syncMusic();},
  commitSlot(){
    if(this.storageBusy||!this._pendingSave)return;
    const index=this._pendingSlotIndex,seq=this._slotsSequence,payload=this._pendingSave;payload.savedAt=Date.now();this.storageBusy=true;this.loading=true;
    storage.set({complete:()=>{},key:slotKey(index),value:JSON.stringify(payload),success:()=>{
      if(seq!==this._slotsSequence)return;this._slotData[index]=payload;this.storageBusy=false;this.loading=false;this._slotsSequence++;this.mode=this.resumeMode;this.syncMusic();this.armAuto();
      this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('MAITETSU_RW5 slot saved',index+1,payload.state.chapter,payload.state.cursor);
    },fail:()=>{if(seq!==this._slotsSequence)return;this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');}});
  },
  openGallery(){
    if(this.loading||this.mode!=='title')return;this.clearTyping();this.mode='gallery';this.syncMusic();
    if(this._galleryCatalog.length){this.refreshGallery();return;}
    this.loading=true;const seq=++this._gallerySequence;
    file.readText({complete:()=>{},uri:'/common/gallery.txt',success:data=>{
      if(seq!==this._gallerySequence)return;
      try{const items=JSON.parse(data.text);if(!Array.isArray(items)||!items.length)throw new Error('CG 目录为空');this._galleryCatalog=groupGallery(items);this._galleryTotal=items.length;this.galleryPage=0;this.loading=false;this.refreshGallery();console.log('MAITETSU_RW5 gallery ready',this._galleryCatalog.length,items.length);}catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this._gallerySequence)this.fail('CG 目录读取失败：'+code);}});
  },
  refreshGallery(){const start=this.galleryPage*4;const items=this._galleryCatalog.slice(start,start+4).map((item,i)=>({image:item.image,label:item.label+'\n'+item.variants.length+' 张',index:start+i,src:imagePath(item.thumbnail)}));this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._galleryCatalog.length+' 组 · '+this._galleryTotal+' 张 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._galleryCatalog.length/4)+' 页';},
  previousGalleryPage(){if(this.loading||this.galleryPage===0)return;this.galleryPage--;this.refreshGallery();},
  nextGalleryPage(){if(this.loading||this.galleryPage>=Math.ceil(this._galleryCatalog.length/4)-1)return;this.galleryPage++;this.refreshGallery();},
  viewCg(index){if((this.mode!=='gallery'&&this.mode!=='cg')||this.loading||index<0||index>=this._galleryCatalog.length)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.syncMusic();this.renderCg();},
  renderCg(){const group=this._galleryCatalog[this.cgIndex],item=group.variants[this.cgVariant];this.cgSrc=imagePath(item.image);this.cgLabel=group.label+(group.variants.length>1?' · 差分 '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换':'');console.log('MAITETSU_RW5 cg',this.cgIndex+1,this.cgVariant+1,item.image);},
  cycleCg(){if(this.mode!=='cg'||this.loading)return;const count=this._galleryCatalog[this.cgIndex].variants.length;if(count<2)return;this.cgVariant=stepVariant(this.cgVariant,1,count);this.renderCg();},
  previousCg(){if(this.mode==='cg'&&this.cgIndex>0)this.viewCg(this.cgIndex-1);},
  nextCg(){if(this.mode==='cg'&&this.cgIndex<this._galleryCatalog.length-1)this.viewCg(this.cgIndex+1);},
  backToGallery(){if(this.mode!=='cg')return;this.galleryPage=Math.floor(this.cgIndex/4);this.refreshGallery();this.mode='gallery';this.syncMusic();},
  syncMusic(){if(this._music)this._music.update(this._alive&&!this._hidden&&this.musicEnabled&&(this.mode==='title'||this.mode==='config'||this.mode==='gallery'||this.mode==='cg'||(this.mode==='slots'&&this._slotsReturnMode==='title')));},
  toggleMusic(){this.musicEnabled=!this.musicEnabled;if(this.musicEnabled&&this._music)this._music.retry();this.refreshSettings();this.persistSettings();this.syncMusic();},
  refreshSettings(){this.musicLabel='标题音乐：'+(this.musicEnabled?'开启':'关闭');this.autoLabel='自动播放：'+(this.autoEnabled?'开启':'关闭');this.autoSpeedLabel='自动速度：'+autoSpeeds[this.autoSpeed];this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===28?'字号：大':'字号：标准';},
  persistSettings(){storage.set({complete:()=>{},key:'maitetsu_rw5_settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed,autoSpeed:this.autoSpeed,musicEnabled:this.musicEnabled}),success:()=>{},fail:()=>{}});},
  toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},
  toggleFont(){this.fontSize=this.fontSize===24?28:24;if(this.mode==='menu'&&this.resumeMode==='play'){this.fullText=wrapText(normalizeText(this.session.text),396,this.fontSize);const plan=planTextRows(this.fullText,++this._textGeneration);this._textRanges=plan.ranges;this.dialogueRows=plan.rows;this.paintText(this.fullText.length);}this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this.cancelStoryRead();this.actors=[];this.dialogueRows=[];this.ops=[];this.cachedChapter=0;this._sceneSignature='';this.session.layers=[];this.stopAuto();this._touchReading=false;this._pendingFrame=false;this._chapterSkip=null;this.clearTyping();this._slotsSequence++;this._gallerySequence++;this.loading=false;this.mode='title';this.syncMusic();this.backgroundSrc='/common/images/black.jpg';this.bodySrc='';},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this.cancelStoryRead();this.stopAuto();this._pendingFrame=false;this._chapterSkip=null;this.clearTyping();this.loading=false;this.mode='error';this.syncMusic();this.errorText=message;console.error('MAITETSU_RW5 error',message);}
}
</script>
<style>
.page{width:432px;height:514px;background-color:#211912;flex-direction:column;}
.screen-art{position:absolute;left:0px;top:0px;width:432px;height:514px;}
.art{position:absolute;top:0px;left:0px;width:432px;height:286px;overflow:hidden;justify-content:center;align-items:center;background-color:#000000;}
.background{width:432px;height:286px;object-fit:contain;}
.body{position:absolute;object-fit:fill;}
.title-panel{position:absolute;top:254px;left:30px;width:182px;height:230px;flex-direction:column;}
.title-action{height:52px;width:182px;margin-bottom:5px;font-size:25px;color:#fff0cf;text-align:left;}
.title-button{width:182px;height:39px;object-fit:contain;}
.dialogue-panel,.choice-panel{position:absolute;top:286px;left:0px;width:432px;height:228px;flex-direction:column;padding:6px 18px 0px;}
.dialogue-skin{position:absolute;top:0px;left:0px;width:432px;height:228px;}
.speaker-row{height:32px;width:396px;justify-content:space-between;align-items:center;margin-bottom:4px;}
.nameplate{width:190px;height:30px;justify-content:center;align-items:center;}
.name-skin{position:absolute;left:0px;top:0px;width:190px;height:30px;}
.speaker{width:182px;font-size:21px;color:#ffffff;text-align:center;}
.chapter{font-size:15px;color:#d7e3fb;}
.dialogue-scroll{width:396px;height:132px;flex-direction:column;justify-content:flex-start;align-items:flex-start;}
.dialogue-content{width:396px;flex-direction:column;}
.dialogue-line{height:34px;width:396px;color:#ffffff;line-height:34px;text-align:left;lines:-1;flex-shrink:0;}
.toolbar{height:46px;width:396px;justify-content:space-between;align-items:center;}
.tool{width:122px;height:34px;border-radius:17px;font-size:19px;color:#fff1d8;background-color:#5b4031;text-align:center;}
.menu-tool{width:96px;}
.choice-title{height:28px;font-size:22px;color:#fff1d8;text-align:center;margin-bottom:4px;}
.choice{height:40px;width:396px;background-color:#5b4031;border-radius:20px;font-size:20px;color:#ffffff;text-align:center;margin-bottom:5px;}
.small-action{position:absolute;top:180px;left:146px;height:36px;width:140px;font-size:19px;color:#fff1d8;background-color:#5b4031;border-radius:18px;text-align:center;}
.overlay{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;padding:22px 32px;}
.menu-title{height:36px;width:368px;font-size:27px;color:#fff1d8;text-align:center;margin-bottom:9px;}
.menu-action{width:368px;height:40px;font-size:21px;color:#fff1d8;background-color:#5b4031;border-radius:20px;margin-bottom:5px;text-align:center;}
.config-panel{padding-top:32px;}
.config-action{width:368px;height:44px;font-size:22px;color:#fff1d8;background-color:#5b4031;border-radius:24px;margin-bottom:8px;text-align:center;}
.config-note{width:368px;height:92px;font-size:19px;line-height:30px;color:#fff1d8;margin-top:8px;}
.config-back{margin-top:5px;}
.full-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;padding:16px 18px;}
.panel-title{height:36px;font-size:27px;color:#fff1d8;text-align:center;margin-bottom:4px;}
.panel-subtitle{height:22px;font-size:16px;color:#ead8bb;text-align:center;margin-bottom:6px;}
.slot-list{height:368px;width:396px;flex-direction:column;}
.slot-card{height:84px;width:396px;margin-bottom:8px;padding:7px 12px;flex-direction:column;}
.slot-skin{position:absolute;top:0px;left:0px;width:396px;height:84px;}
.slot-title{height:26px;font-size:22px;color:#3e2b20;}
.slot-meta{height:19px;font-size:16px;color:#6d5746;}
.slot-preview{height:22px;font-size:18px;color:#4b3828;}
.pager{height:44px;width:396px;padding:0px 8px;justify-content:space-between;align-items:center;background-color:#5b4031;border-radius:22px;}
.pager-action{font-size:19px;color:#fff1d8;padding:8px 2px;}
.gallery-row{height:184px;width:396px;justify-content:space-between;}
.gallery-card{height:176px;width:192px;padding:6px;flex-direction:column;background-color:#e8d6b5;border-radius:10px;}
.gallery-thumb{height:116px;width:180px;object-fit:contain;background-color:#241e17;}
.gallery-caption{height:48px;width:180px;font-size:18px;line-height:22px;color:#443023;text-align:center;}
.cg-panel{position:absolute;top:0px;left:0px;width:432px;height:514px;flex-direction:column;background-color:#000000;}
.cg-image{width:432px;height:432px;object-fit:contain;}
.cg-caption{width:432px;height:28px;font-size:18px;color:#e9eef8;text-align:center;}
.cg-controls{width:432px;height:54px;padding:0px 18px;justify-content:space-between;align-items:center;background-color:#5b4031;}
.confirm-panel{padding-top:90px;}
.confirm-text{height:130px;font-size:23px;line-height:32px;color:#fff1d8;margin:16px 0px;}
.error-text{height:180px;font-size:22px;color:#ffffff;margin:12px 0px;}
.end-panel{position:absolute;top:280px;left:32px;width:368px;flex-direction:column;}
.game-title{height:44px;font-size:28px;color:#ffffff;text-align:center;}
.subtitle{height:40px;font-size:21px;color:#d1def6;text-align:center;margin-bottom:20px;}
.loading{position:absolute;top:234px;left:128px;width:176px;height:46px;text-align:center;font-size:23px;color:#ffffff;background-color:#5b4031;border-radius:23px;}
.title-logo{position:absolute;left:40px;top:10px;width:352px;height:119px;object-fit:contain;}
.art-touch{position:absolute;left:0px;top:0px;width:432px;height:286px;background-color:transparent;}
</style>
